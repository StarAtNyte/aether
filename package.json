{
  "name": "aether-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Aether \u2014 an AI-native WebGL/WebGPU framework that turns natural language into physically verified, interactive 3D worlds.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aether/studio",
    "dev:server": "npm run dev -w @aether/server",
    "bridge": "tsx apps/bridge/src/main.ts",
    "build": "npm run build -w @aether/studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "NODE_ENV=production node --import tsx apps/server/src/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "e2e": "tsx tests/e2e/studio.e2e.ts",
    "e2e:memory": "tsx tests/e2e/memory.e2e.ts",
    "gallery": "tsx tests/e2e/gallery.e2e.ts",
    "thumbnails": "tsx tests/e2e/thumbnails.e2e.ts",
    "e2e:layout": "tsx tests/e2e/layout.e2e.ts",
    "e2e:projects": "tsx tests/e2e/projects.e2e.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
