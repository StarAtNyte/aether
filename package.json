{
  "name": "aether-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Aether — an AI-native WebGL/WebGPU framework that turns natural language into physically verified, interactive 3D worlds.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarAtNyte/aether.git"
  },
  "bugs": {
    "url": "https://github.com/StarAtNyte/aether/issues"
  },
  "homepage": "https://aether-studio-lyart.vercel.app",
  "keywords": [
    "webgpu",
    "threejs",
    "webgl",
    "ai-agents",
    "procedural-generation",
    "3d",
    "game-engine",
    "architecture-visualization",
    "mcp",
    "typescript"
  ],
  "author": "Aether contributors",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aether": "apps/cli/bin/aether.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aether/studio",
    "dev:fast": "AETHER_DEV_PREBUNDLE=1 npm run dev -w @aether/studio",
    "dev:server": "npm run dev -w @aether/server",
    "aether": "node apps/cli/bin/aether.mjs",
    "aether:start": "node apps/cli/bin/aether.mjs start",
    "aether:stop": "node apps/cli/bin/aether.mjs stop",
    "bridge": "tsx apps/bridge/src/main.ts",
    "build": "npm run build -w @aether/studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "NODE_ENV=production node --import tsx apps/server/src/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "demo:record": "tsx scripts/demo/record.ts",
    "demo:compose": "tsx scripts/demo/compose.ts",
    "demo:verify": "tsx scripts/demo/verify.ts",
    "demo": "tsx scripts/demo/record.ts && tsx scripts/demo/compose.ts && tsx scripts/demo/verify.ts",
    "budget": "tsx scripts/check-budget.ts",
    "licences": "tsx scripts/check-licences.ts",
    "check:ui-colour": "tsx scripts/check-ui-colour.ts",
    "e2e": "tsx tests/e2e/studio.e2e.ts",
    "e2e:memory": "tsx tests/e2e/memory.e2e.ts",
    "e2e:switch": "tsx tests/e2e/worldswitch.e2e.ts",
    "e2e:honesty": "tsx tests/e2e/honesty.e2e.ts",
    "e2e:voxel": "tsx tests/e2e/voxel.e2e.ts",
    "e2e:backend": "tsx tests/e2e/backend.e2e.ts",
    "e2e:weak": "tsx tests/e2e/weak-gpu.e2e.ts",
    "e2e:blank": "tsx tests/e2e/blank-frames.e2e.ts",
    "e2e:eyelight": "tsx tests/e2e/eye-light.e2e.ts",
    "e2e:parity": "tsx tests/e2e/gpu-parity.e2e.ts",
    "e2e:capture": "tsx tests/e2e/capture-aspect.e2e.ts",
    "e2e:arch": "tsx tests/e2e/arch.e2e.ts",
    "e2e:interact": "tsx tests/e2e/interact.e2e.ts",
    "e2e:design": "tsx tests/e2e/design.e2e.ts",
    "e2e:photo": "tsx tests/e2e/photo.e2e.ts",
    "eval:design": "tsx scripts/eval-design.ts",
    "eval:photo": "tsx scripts/eval-photo.ts",
    "e2e:benchmark": "tsx tests/e2e/benchmark.e2e.ts",
    "gallery": "tsx tests/e2e/gallery.e2e.ts",
    "thumbnails": "tsx tests/e2e/thumbnails.e2e.ts",
    "e2e:layout": "tsx tests/e2e/layout.e2e.ts",
    "e2e:projects": "tsx tests/e2e/projects.e2e.ts",
    "e2e:bridge": "tsx tests/e2e/bridge.e2e.ts",
    "e2e:connection": "tsx tests/e2e/connection.e2e.ts",
    "e2e:editing": "tsx tests/e2e/editing.e2e.ts",
    "e2e:npc": "tsx tests/e2e/npc.e2e.ts",
    "e2e:characters": "tsx tests/e2e/characters.e2e.ts",
    "e2e:local": "tsx tests/e2e/local.e2e.ts",
    "e2e:hosted": "tsx tests/e2e/hosted.e2e.ts",
    "eval": "tsx scripts/eval-agent.ts",
    "bench": "tsx scripts/bench/run.ts",
    "bench:quick": "tsx scripts/bench/run.ts --quick",
    "bench:photo-selftest": "tsx scripts/photo-selftest/run.ts",
    "eval:edits": "tsx scripts/eval-edits.ts",
    "e2e:refine": "tsx tests/e2e/refine.e2e.ts",
    "library": "tsx scripts/build-generator-library.ts",
    "e2e:cli": "tsx tests/e2e/cli.e2e.ts",
    "e2e:mcp": "tsx tests/e2e/mcp.e2e.ts",
    "assets:fetch": "tsx scripts/assets/fetch.ts",
    "assets:simready": "tsx scripts/assets/simready.ts",
    "assets:build": "tsx scripts/assets/build.ts",
    "assets:thumbs": "tsx scripts/assets/thumbs.ts",
    "assets:ktx2": "tsx scripts/assets/ktx2.ts",
    "characters:build": "tsx scripts/characters/build.ts",
    "characters:preview": "tsx scripts/characters/preview.ts",
    "e2e:assets": "tsx tests/e2e/assets.e2e.ts",
    "e2e:ux": "tsx tests/e2e/ux.e2e.ts",
    "e2e:verified": "tsx tests/e2e/verified.e2e.ts",
    "e2e:vfx": "tsx tests/e2e/vfx.e2e.ts",
    "e2e:publish": "tsx tests/e2e/publish.e2e.ts",
    "e2e:proof": "tsx tests/e2e/proof.e2e.ts",
    "showcase:bake": "tsx scripts/showcase/bake.ts",
    "showcase:lightmaps": "tsx scripts/showcase/lightmaps.ts",
    "e2e:lightmap-open": "tsx tests/e2e/lightmap-open.e2e.ts",
    "showcase:photo-rooms": "tsx scripts/showcase/photo-rooms.ts",
    "showcase:thumbs": "tsx tests/e2e/showcase.e2e.ts --capture",
    "e2e:showcase": "tsx tests/e2e/showcase.e2e.ts",
    "e2e:security": "tsx tests/e2e/security.e2e.ts",
    "shots": "tsx tests/e2e/shots.e2e.ts",
    "e2e:soak": "tsx tests/e2e/soak.e2e.ts",
    "e2e:photoreal": "tsx tests/e2e/photoreal.e2e.ts",
    "e2e:gameplay": "tsx tests/e2e/gameplay.e2e.ts",
    "e2e:render-bench": "tsx tests/e2e/render-bench.e2e.ts",
    "e2e:ktx2": "tsx tests/e2e/ktx2.e2e.ts",
    "e2e:load-perf": "tsx tests/e2e/load-perf.e2e.ts",
    "e2e:render": "tsx tests/e2e/render-quality.e2e.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@dimforge/rapier3d-compat": "0.21.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "meshoptimizer": "1.1.1",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
