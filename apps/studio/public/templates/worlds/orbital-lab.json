4,"timeOfDay":10,"weather":"clear"},"generators":{"robot":{"description":"Friendly retro robot with a boxy control-panel torso, rounded head, glowing eyes, antenna, articulated limbs, and details visible from every side.","id":"robot","params":{"color":{"default":"#4f91a8","description":"primary painted metal color","type":"color"},"eyeColor":{"default":"#7dffda","description":"glowing eye and indicator color","type":"color"},"height":{"default":2.2,"description":"overall robot height in meters","max":8,"min":0.8,"type":"number"}},"source":"const H = params.height;\nconst s = H / 2.2;\nconst primary = { preset: 'metal', color: params.color, metalness: 0.55, roughness: 0.34 };\nconst trim = { preset: 'metal', color: '#d9d3bf', metalness: 0.72, roughness: 0.26 };\nconst dark = { preset: 'metal', color: '#303944', metalness: 0.7, roughness: 0.3 };\nconst rubber = { preset: 'rubber', color: '#20262c', roughness: 0.82 };\nconst glow = { preset: 'emissive', color: params.eyeColor, emissive: params.eyeColor, emissiveIntensity: 3.5, roughness: 0.18 };\nconst red = { preset: 'emissive', color: '#ff604f', emissive: '#ff3020', emissiveIntensity: 1.8 };\nconst torsoY = 1.15 * s;\napi.add(api.box(0.82*s, 0.72*s, 0.48*s).translate(0, torsoY, 0), primary);\napi.add(api.box(0.72*s, 0.055*s, 0.40*s).translate(0, 0.775*s, 0), trim);\napi.add(api.box(0.58*s, 0.42*s, 0.045*s).translate(0, 1.15*s, 0.263*s), dark);\napi.add(api.box(0.48*s, 0.055*s, 0.025*s).translate(0, 1.28*s, 0.292*s), trim);\nfor (let i = 0; i < 4; i++) {\n  const x = (-0.18 + i * 0.12) * s;\n  const mat = i === 0 ? red : (i === 1 ? glow : trim);\n  api.add(api.sphere(0.035*s, 1).scale(1, 1, 0.45).translate(x, 1.10*s, 0.294*s), mat);\n}\nfor (let i = 0; i < 3; i++) api.add(api.box(0.34*s, 0.025*s, 0.018*s).translate(0, (0.99-i*0.055)*s, 0.295*s), trim);\napi.add(api.box(0.44*s, 0.26*s, 0.035*s).translate(0, 1.18*s, -0.258*s), dark);\nfor (let i = 0; i < 4; i++) api.add(api.box(0.28*s, 0.018*s, 0.018*s).translate(0, (1.27-i*0.06)*s, -0.281*s), trim);\napi.add(api.cylinder(0.15*s, 0.15*s, 0.13*s, 12).translate(0, 1.57*s, 0), dark);\napi.add(api.cylinder(0.34*s, 0.34*s, 0.08*s, 16).translate(0, 1.65*s, 0), trim);\napi.add(api.cylinder(0.31*s, 0.31*s, 0.34*s, 16).translate(0, 1.84*s, 0), primary);\napi.add(api.sphere(0.31*s, 2).scale(1, 0.45, 1).translate(0, 2.01*s, 0), primary);\napi.add(api.box(0.46*s, 0.16*s, 0.035*s).translate(0, 1.87*s, 0.305*s), dark);\nfor (let i = -1; i <= 1; i += 2) {\n  const x = i * 0.14*s;\n  api.add(api.sphere(0.072*s, 2).scale(1, 0.78, 0.38).translate(x, 1.89*s, 0.337*s), glow);\n  api.add(api.torus(0.075*s, 0.018*s).translate(x, 1.89*s, 0.326*s), trim);\n}\napi.add(api.box(0.14*s, 0.022*s, 0.018*s).translate(0, 1.76*s, 0.333*s), trim);\napi.add(api.box(0.22*s, 0.11*s, 0.035*s).translate(0, 1.87*s, -0.326*s), dark);\napi.add(api.cylinder(0.025*s, 0.025*s, 0.25*s, 8).translate(0, 2.22*s, 0), trim);\napi.add(api.sphere(0.07*s, 2).translate(0, 2.37*s, 0), red);\nfor (let side = -1; side <= 1; side += 2) {\n  const x = side * 0.53*s;\n  api.add(api.sphere(0.13*s, 1).translate(side*0.45*s, 1.36*s, 0), dark);\n  api.add(api.cylinder(0.105*s, 0.105*s, 0.38*s, 10).rotate(0, 0, side*8).translate(x, 1.18*s, 0), primary);\n  api.add(api.sphere(0.12*s, 1).translate(side*0.56*s, 0.98*s, 0), trim);\n  api.add(api.cylinder(0.09*s, 0.09*s, 0.30*s, 10).rotate(0, 0, -side*5).translate(side*0.575*s, 0.82*s, 0), primary);\n  api.add(api.sphere(0.13*s, 1).scale(0.8, 1, 0.75).translate(side*0.59*s, 0.62*s, 0), dark);\n}\nfor (let side = -1; side <= 1; side += 2) {\n  const x = side * 0.22*s;\n  api.add(api.cylinder(0.13*s, 0.13*s, 0.30*s, 10).translate(x, 0.61*s, 0), primary);\n  api.add(api.sphere(0.14*s, 1).translate(x, 0.43*s, 0), dark);\n  api.add(api.cylinder(0.115*s, 0.13*s, 0.27*s, 10).translate(x, 0.275*s, 0), trim);\n  api.add(api.box(0.31*s, 0.12*s, 0.43*s).translate(x, 0.06*s, 0.07*s), primary);\n  api.add(api.box(0.32*s, 0.035*s, 0.44*s).translate(x, 0.0175*s, 0.07*s), rubber);\n}\napi.collider({ kind: 'box', halfExtents: [0.41*s, 0.36*s, 0.24*s], offset: [0, torsoY, 0] });\napi.collider({ kind: 'sphere', radius: 0.33*s, offset: [0, 1.87*s, 0] });\napi.collider({ kind: 'box', halfExtents: [0.38*s, 0.38*s, 0.28*s], offset: [0, 0.38*s, 0] });\napi.collider({ kind: 'box', halfExtents: [0.66*s, 0.42*s, 0.18*s], offset: [0, 1.04*s, 0] });\nreturn api.build();"},"satellite-dish":{"description":"Large steerable radio telescope with a thick parabolic reflector, rear structural ribs, central feed horn and tripod receiver supports on a detailed tilt mount and concrete base.","id":"satellite-dish","params":{"color":{"default":"#d9dde0","description":"reflector and structural frame color","type":"color"},"diameter":{"default":8,"description":"reflector diameter in meters","max":30,"min":2,"type":"number"},"tilt":{"default":35,"description":"dish elevation angle in degrees","max":80,"min":5,"type":"number"}},"source":"const D = params.diameter;\nconst R = D * 0.5;\nconst tilt = params.tilt;\nconst depth = D * 0.18;\nconst thick = D * 0.018;\nconst pivotY = D * 0.68;\nconst rad = tilt * Math.PI / 180;\nconst structure = { preset: 'metal', color: params.color, metalness: 0.45, roughness: 0.38, flatShading: true };\nconst darkMetal = { preset: 'metal', color: '#343b42', metalness: 0.75, roughness: 0.3 };\nconst concrete = { preset: 'concrete', color: '#8b8f91', roughness: 0.92, flatShading: true };\nconst accent = { preset: 'metal', color: '#d9822b', metalness: 0.55, roughness: 0.35 };\nfunction dishPoint(r, a, extra) {\n  const y = -depth + depth * (r * r) / (R * R) + extra;\n  const x0 = Math.cos(a) * r;\n  const z0 = Math.sin(a) * r;\n  return [x0 * Math.cos(rad) - y * Math.sin(rad), pivotY + x0 * Math.sin(rad) + y * Math.cos(rad), z0];\n}\nfunction axisPoint(y) {\n  return [-y * Math.sin(rad), pivotY + y * Math.cos(rad), 0];\n}\nconst profile = [];\nfor (let i = 0; i <= 10; i++) {\n  const r = R * i / 10;\n  profile.push([r, -depth - thick + depth * (r * r) / (R * R)]);\n}\nprofile.push([R, thick * 0.35]);\nfor (let i = 10; i >= 0; i--) {\n  const r = R * i / 10;\n  profile.push([r, -depth + depth * (r * r) / (R * R)]);\n}\nconst reflector = api.lathe(profile, 32).rotate(0, 0, tilt).translate(0, pivotY, 0);\nreflector.vertexColor((x, y, z) => api.mix(params.color, '#ffffff', 0.08 + 0.07 * api.noise3(x * 0.7, y * 0.7, z * 0.7)));\napi.add(reflector, { preset: 'metal', metalness: 0.32, roughness: 0.46, flatShading: true });\nconst rim = api.torus(R, thick * 0.85).rotate(90, 0, 0).rotate(0, 0, tilt).translate(0, pivotY, 0);\napi.add(rim, structure);\nfor (let k = 0; k < 12; k++) {\n  const a = k * Math.PI * 2 / 12;\n  const path = [];\n  for (let j = 1; j <= 8; j++) path.push(dishPoint(R * j / 8, a, -thick * 1.15));\n  api.add(api.tube(path, thick * 0.38, 6), darkMetal);\n}\nconst rearHub = dishPoint(0, 0, -thick * 2.2);\napi.add(api.sphere(D * 0.055, 1).translate(rearHub[0], rearHub[1], rearHub[2]), darkMetal);\nconst focusDist = D * 0.52;\nconst feed = axisPoint(focusDist);\nconst feedBack = axisPoint(focusDist - D * 0.09);\napi.add(api.tube([feedBack, feed], D * 0.035, 10), darkMetal);\napi.add(api.cone(D * 0.075, D * 0.13, 12).rotate(0, 0, tilt + 180).translate(feed[0], feed[1], feed[2]), accent);\nfor (let k = 0; k < 3; k++) {\n  const a = k * Math.PI * 2 / 3;\n  const edge = dishPoint(R * 0.78, a, thick * 0.8);\n  api.add(api.tube([edge, feedBack], D * 0.018, 6), structure);\n}\nconst baseR = D * 0.22;\napi.add(api.cylinder(baseR * 1.18, baseR * 1.32, D * 0.16, 20).translate(0, D * 0.08, 0), concrete);\napi.add(api.cylinder(baseR, baseR * 1.08, D * 0.32, 18).translate(0, D * 0.32, 0), concrete);\napi.add(api.cylinder(baseR * 0.83, baseR * 0.83, D * 0.08, 18).translate(0, D * 0.52, 0), darkMetal);\nconst axleLen = D * 0.36;\napi.add(api.cylinder(D * 0.075, D * 0.075, axleLen, 14).rotate(90, 0, 0).translate(0, pivotY, 0), darkMetal);\nfor (let side = -1; side <= 1; side += 2) {\n  const z = side * D * 0.18;\n  const leg = api.tube([[0, D * 0.52, z], [0, pivotY, z]], D * 0.045, 8);\n  api.add(leg, structure);\n  api.add(api.cylinder(D * 0.105, D * 0.105, D * 0.07, 14).rotate(90, 0, 0).translate(0, pivotY, z), accent);\n}\napi.add(api.box(D * 0.22, D * 0.14, D * 0.16).translate(baseR * 0.92, D * 0.4, 0), darkMetal);\napi.add(api.cylinder(D * 0.035, D * 0.035, D * 0.18, 10).translate(baseR * 1.02, D * 0.58, 0), accent);\napi.collider({ kind: 'cylinder', radius: baseR * 1.32, halfHeight: D * 0.26, offset: [0, D * 0.26, 0] });\napi.collider({ kind: 'sphere', radius: R, offset: [0, pivotY, 0] });\nreturn api.build();"}},"hud":[{"key":"cells","label":"Power cells / 5"}],"id":"world","intro":{"accent":"#4cc9f0","controls":["WASD — move","Space — bound","Mouse — look","R — restart","Esc — editor"],"objective":"Bound across the station, recover the five power cells and restart the reactor.","tagline":"Low gravity, humming machines and a blue planet filling the sky.","title":"Orbital Lab"},"meshes":{},"name":"Orbital Lab","player":{"jumpSpeed":6,"mode":"thirdPerson","moveSpeed":5.5,"spawn":[0,1,8.5]},"rules":[{"enabled":true,"id":"hint","if":[],"once":false,"then":[{"do":"message","duration":4,"text":"Low gravity! Talk to K-7, then find the five power cells."}],"when":{"on":"start"}},{"enabled":true,"id":"reactor-ready","if":[],"once":true,"then":[{"behavior":"goal","do":"enableBehavior","enabled":true,"target":"reactor-1"},{"do":"setProperty","path":"light.intensity","target":"reactor-1-light-1","value":4},{"do":"setProperty","path":"material.emissiveIntensity","target":"reactor-core-1","value":4},{"do":"message","duration":4,"text":"All cells loaded. Touch the reactor!"},{"do":"sound","sound":"bell"}],"when":{"key":"cells","on":"state","op":">=","value":5}},{"enabled":true,"id":"reset-key","if":[],"once":false,"then":[{"do":"reset"}],"when":{"key":"r","on":"key"}}],"scripts":{},"seed":1,"state":{"cells":0},"tests":[{"distance":2,"id":"crane-slews","kind":"moves","target":"#crane","within":6},{"distance":2,"id":"lift-runs","kind":"moves","target":"#lift","within":6},{"id":"cells-float","kind":"staysAbove","target":"#cell","within":3,"y":1},{"id":"machines-hold","kind":"staysAbove","target":"#machine","within":6,"y":1}],"version":1}}
